PORT=8080

# 解析微服务地址(Node officeparser 提取管线,见 ../parse-service/)
PYTHON_SERVICE=http://localhost:8000

# RAG启用开关
RAG_ENABLED=true

# LLM Providers - JSON数组格式
LLM_PROVIDERS=[
  {
    "name": "openai",
    "api_key": "${OPENAI_API_KEY}",
    "base_url": "https://api.openai.com/v1",
    "model_name": "gpt-4",
    "type": "openai"
  },
  {
    "name": "dashscope",
    "api_key": "${DASHSCOPE_API_KEY}",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model_name": "qwen-max",
    "type": "dashscope"
  },
  {
    "name": "deepseek",
    "api_key": "${DEEPSEEK_API_KEY}",
    "base_url": "https://api.deepseek.com/v1",
    "model_name": "deepseek-chat",
    "type": "deepseek"
  }
]

# 可选：设置默认模型
# DEFAULT_MODEL=gpt-4
